# cPanel / Apache fallback for the static AbanRemit build.
# The app uses hash routing in the cPanel package so it works from public_html/
# or from an extracted subfolder without broken asset paths.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite real files or directories (assets, /assets/*.js, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> SPA shell
  RewriteRule ^ index.html [L]
</IfModule>

# Long-cache hashed assets, but never cache the SPA shell or stale-worker cleanup files.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|.*\.html|sw\.js|service-worker\.js|manifest\.json|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|png|jpg|jpeg|gif|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Gzip when available
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
